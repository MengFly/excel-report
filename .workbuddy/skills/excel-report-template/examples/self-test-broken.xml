        <defaultRowHeight>24</defaultRowHeight>
        <defaultRowHeigt>24</defaultRowHeigt>
    </sheetStyle>

    <styles>
        <style id="ok">
            <alignHorizontal>middle</alignHorizontal>
            <fontBould>true</fontBould>
            <fontColor>grey_50_percent</fontColor>
        </style>
        <style id="same">
            <width>auto</width>
        </style>
        <style id="same">
            <width>auto</width>
        </style>
    </styles>

    <container>
        <VLayout>
            <Text size="3" style="missingStyle" text="x"/>
            <Text text="y" unknownAttr="1"/>
            <Bogus/>
            <Span size="2,1" style="{width:auto}"/>
            <GridLayout count="0" orientation="diagonal"/>
            <List dataList="${list}" orientation="sideways"/>
            <Table headerVisible="false"/>
            <Chart size="4,10">
                <Legend position="middle"/>
            </Chart>
            <VLayout for="${list}">
                <Text text="z"/>
            </VLayout>
            <PieData>
                <labelAxis type="category">
                    <data title="X" valueType="value"/>
                </labelAxis>
                <valueAxis title="V">
                    <data title="V" type="bar"/>
                </valueAxis>
            </PieData>
        </VLayout>
        <VLayout/>
    </container>
</template>
